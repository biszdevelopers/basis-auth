NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://basis_auth:basis_auth@localhost:5432/basis_auth
INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters
INTERNAL_API_HOST=127.0.0.1
INTERNAL_API_PORT=3001
OIDC_ISSUER=http://localhost:3000
OIDC_COOKIE_KEYS=replace-with-at-least-32-random-characters,replace-with-a-second-32-character-key

# Generate with: bun run keys:generate
# Required in production. Development generates an ephemeral key when omitted.
OIDC_JWKS_JSON=
# Alternatively, point at a mounted JSON file containing private JWKs.
# OIDC_JWKS_FILE=/run/secrets/oidc-jwks.json

OIDC_RESOURCES_JSON=[{"audience":"devconnect://nethack.bisz.dev","scopes":["nethack.access"]}]
OIDC_CLIENTS_JSON=[{"clientId":"basishacks","name":"Network Hackathon","clientSecret":"replace-with-a-long-random-client-secret","redirectUris":["http://localhost:24598/api/auth/basis/callback"],"public":false,"scopes":["nethack.access"],"permissions":{"nethack.Profile.updateSelf":"Update the authenticated user's own Network Hackathon profile","nethack.Teams.create":"Create a Network Hackathon team","nethack.Teams.membersAddOwn":"Add members to the authenticated user's own team","nethack.Teams.membersRemoveOwn":"Remove members from the authenticated user's own team","nethack.Teams.list":"View the complete list of Network Hackathon teams","nethack.Teams.delete":"Delete Network Hackathon teams","nethack.Projects.updateOwn":"Update project details for the authenticated user's own team","nethack.Projects.submitOwn":"Submit the authenticated user's own team project","nethack.Voting.readOwn":"View the authenticated user's own peer-voting ballot","nethack.Voting.submitOwn":"Submit the authenticated user's own peer-voting ballot","nethack.Judging.assignmentsRead":"View assigned teams and judging assignments","nethack.Judging.scoresWriteAssigned":"Create or update scores for assigned teams","nethack.Judging.resultsRead":"View private judging scores and results","nethack.Judging.resultsCompute":"Compute final Network Hackathon scores and rankings","nethack.Seasons.create":"Create Network Hackathon seasons","nethack.Seasons.update":"Update Network Hackathon seasons and their settings","nethack.Seasons.delete":"Delete Network Hackathon seasons","nethack.Seasons.activate":"Set the active Network Hackathon season","nethack.Hackathon.read":"View private hackathon state and configuration","nethack.Hackathon.update":"Update hackathon state and configuration","nethack.Users.list":"View the complete list of Network Hackathon users","nethack.Users.delete":"Delete Network Hackathon user accounts","nethack.Debug.filesRead":"View files exposed by development and debugging tools","nethack.Debug.filesWrite":"Upload files through development and debugging tools","nethack.Debug.deepseekRead":"View DeepSeek debugging sessions and messages","nethack.Debug.deepseekWrite":"Create, modify, and delete DeepSeek debugging sessions and messages","nethack.Chatbot.use":"Use the Network Hackathon chatbot","nethack.Database.export":"Export the Network Hackathon database"},"resources":["devconnect://nethack.bisz.dev"],"requireConsent":true,"filterMode":null,"filterContent":[]}]
DEFAULT_PERMISSION=participant
BOOTSTRAP_PERMISSION_GRANTS_JSON=[{"email":"admin@example.edu","permissions":["admin"]}]

# Microsoft Entra tenant-specific issuer, not /common. Set all three together.
MICROSOFT_ISSUER=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: comma-separated origins allowed to call /oauth/token and
# /oauth/userinfo via CORS. Empty (default) disables CORS entirely.
CORS_ALLOWED_ORIGINS=

# Session lifetime (milliseconds). Idle sessions expire after the first value;
# an absolute ceiling is enforced regardless of activity. Defaults shown.
SESSION_IDLE_TIMEOUT_MS=43200000
SESSION_ABSOLUTE_MAX_MS=2592000000

# PostgreSQL connection pool tuning (optional). Defaults shown.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=30000
