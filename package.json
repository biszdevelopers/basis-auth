{
  "name": "basis-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "scripts": {
    "dev": "vite build --config web/vite.config.ts && concurrently --kill-others-on-fail -n auth,build,web \"node --watch --import tsx src/index.ts\" \"vite build --watch --config web/vite.config.ts\" \"vite --config web/vite.config.ts\"",
    "dev:auth": "node --watch --import tsx src/index.ts",
    "dev:client": "vite build --watch --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "bun run build:web && tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "bun run build:web && vitest run",
    "test:watch": "vitest",
    "keys:generate": "tsx scripts/generate-jwks.ts",
    "clients": "tsx scripts/clients.ts",
    "clients:add": "tsx scripts/add-client.ts",
    "clients:remove": "tsx scripts/remove-client.ts",
    "clients:doctor": "tsx scripts/client-doctor.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@basis/schema": "link:@basis/schema",
    "@hono/node-server": "^2.1.6",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "jdenticon": "^3.3.0",
    "jose": "^6.2.15",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.70.0",
    "openid-client": "6.8.9",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "jsdom": "31.0.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
