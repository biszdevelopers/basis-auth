{
  "name": "basis-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "scripts": {
    "dev": "vite build --config web/vite.config.ts && concurrently --kill-others-on-fail -n auth,build,web \"node --watch --import tsx src/index.ts\" \"vite build --watch --config web/vite.config.ts\" \"vite --config web/vite.config.ts\"",
    "dev:auth": "node --watch --import tsx src/index.ts",
    "dev:client": "vite build --watch --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "bun run build:web && tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "keys:generate": "tsx scripts/generate-jwks.ts",
    "clients": "tsx scripts/clients.ts",
    "clients:add": "tsx scripts/add-client.ts",
    "clients:remove": "tsx scripts/remove-client.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@basis/schema": "link:@basis/schema",
    "@hono/node-server": "^2.0.12",
    "@hugeicons/core-free-icons": "^4.2.3",
    "lru-cache": "^11.0.2",
    "@hugeicons/react": "^1.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.33",
    "jdenticon": "^3.3.0",
    "jose": "^6.2.7",
    "lucide-react": "^1.28.0",
    "openid-client": "6.8.4",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "27.2.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
